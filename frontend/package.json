{
  "name": "try-not-to-be-poor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "generate:api": "../scripts/generate-client.sh",
    "check:contracts": "ngc -p tsconfig.contracts.json",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "prestart": "npm run generate:api",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "e2e": "playwright test",
    "e2e:transition": "playwright test --config playwright.transition.config.ts",
    "e2e:automation": "playwright test --config playwright.automation.config.ts",
    "test": "ng test --watch=false",
    "test:unit": "ng test --watch=false --include=\"app/shared/*.spec.ts\"",
    "test:component": "ng test --watch=false --exclude=\"app/shared/*.spec.ts\"",
    "test:coverage": "ng test --watch=false --coverage",
    "pretest": "npm run generate:api",
    "pretest:unit": "npm run generate:api",
    "pretest:component": "npm run generate:api",
    "pretest:coverage": "npm run generate:api"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "jsdom": "27.4.0"
  },
  "overrides": {
    "vite": "8.3.3"
  }
}
