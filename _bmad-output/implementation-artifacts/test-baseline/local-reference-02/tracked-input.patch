it expect(page.locator('#update-title')).toBeFocused();\n    await expect(page.getByRole('navigation')).toHaveCount(0);\n    expect(intercepted).toBe(1);\n    expect(refreshes).toBe(operation === 'refresh' ? 1 : 0);\n    for (const viewport of [{ width: 320, height: 568 }, { width: 390, height: 844 }, { width: 768, height: 1024 }, { width: 1280, height: 800 }]) {\n      await page.setViewportSize(viewport);\n      await page.evaluate(() => document.documentElement.style.fontSize = '200%');\n      expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);\n      const button = page.getByRole('button', { name: 'Seite vollständig neu laden' });\n      expect((await button.boundingBox())!.height).toBeGreaterThanOrEqual(44);\n      expect((await new AxeBuilder({ page }).analyze()).violations).toEqual([]);\n      await page.evaluate(() => document.documentElement.style.fontSize = '');\n    }\n    await isolated.close();\n  }""]",browser,SC:FE:version-transition.spec.ts:8936b2699561,[],"[""3.7/AC-6"", ""3.7/AC-7""]","[""actual browser accessibility or journey boundary"", ""session/UI/input/response-order""]","[""Actual browser DOM/keyboard/focus/announcements/reflow/HTTP wiring for this stated path; pure state/format/input variants may be supplemented by isolated components.""]","[""Gleiche UI-Regel/Eingabe bei Anlage und Bearbeitung wird einmal gezählt; konkrete Editor-/HTTP-/Fokuspfade bleiben als ergänzende Nachweise erhalten.""]"
